# Copy to .env and fill in your values
# .env is gitignored by default — never commit real tokens

# Meta Graph API long-lived token
# Get it: https://developers.facebook.com/tools/explorer
# Exchange short-lived for 60-day long-lived, then refresh via cron before expiry
IG_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Instagram Business Account ID (numeric)
# Get it: GET /me/accounts → find your page → GET /{page-id}?fields=instagram_business_account
IG_ACCOUNT_ID=17841XXXXXXXXXXXX

# Optional: queue file path (default: queue.json in same folder)
# QUEUE_FILE=/path/to/queue.json
